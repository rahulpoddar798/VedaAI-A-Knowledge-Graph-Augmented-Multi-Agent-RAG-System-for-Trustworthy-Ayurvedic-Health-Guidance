# Environment Variables Template — VedaAI
# Copy this file to .env and fill in your credentials
# NEVER commit .env to git

# Neo4j Aura Cloud Credentials
# Get these from your Neo4j Aura dashboard: https://console.neo4j.io
NEO4J_URI=neo4j+s://YOUR_INSTANCE_ID.databases.neo4j.io
NEO4J_USERNAME=YOUR_USERNAME
NEO4J_PASSWORD=YOUR_PASSWORD

# (Phase 2) Google Gemini API Key
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Comma-separated list of allowed CORS browser origins (required in production)
# Example: CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# Optional reverse proxy CIDRs. Leave blank for direct connections.
TRUSTED_PROXY_CIDRS=

# Shared per-process budget for uploads, consultations and follow-ups.
MAX_CLINICAL_REQUESTS=8

# Use neo4j after a successful additive IMPPAT import. Default uses the bundled tables.
IMPPAT_RETRIEVAL_BACKEND=tsv
